model AuditLog {
    id         String   @id @default(uuid(7))
    userId     String?
    user       User?    @relation(fields: [userId], references: [id])
    action     String
    entityType String
    entityId   String
    changes    Json?
    createdAt  DateTime @default(now())

    @@index([userId])
    @@index([action])
    @@index([createdAt])
    @@map("audit_logs")
}
