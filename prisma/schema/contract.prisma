model Contract {
  id             String         @id @default(uuid(7))
  jobId          String         @unique
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposalId     String         @unique
  proposal       Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientId       String
  client         User           @relation("clientContracts", fields: [clientId], references: [id])
  freelancerId   String
  freelancer     User           @relation("freelancerContracts", fields: [freelancerId], references: [id])
  agreedPrice    Decimal        @db.Decimal(10, 2)
  agreedTimeline Int
  status         ContractStatus @default(ACTIVE)
  startDate      DateTime       @default(now())
  endDate        DateTime?
  deliverables   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  payments Payment[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@map("contracts")
}

model Payment {
  id                    String        @id @default(uuid(7))
  contractId            String        @unique
  contract              Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientId              String
  client                User          @relation("clientPayments", fields: [clientId], references: [id])
  freelancerId          String
  freelancer            User          @relation("freelancerPayments", fields: [freelancerId], references: [id])
  amount                Decimal       @db.Decimal(10, 2)
  platformCommission    Decimal       @db.Decimal(10, 2)
  freelancerEarns       Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([contractId])
  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@map("payments")
}
