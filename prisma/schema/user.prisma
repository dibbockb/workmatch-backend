model User {
  id                 String    @id @default(uuid())
  name               String
  email              String
  password           String
  emailVerified      Boolean   @default(false)
  needPasswordChange Boolean   @default(false)
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([email])
  @@map("users")
}
