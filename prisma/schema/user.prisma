model User {
  id                 String     @id @default(uuid(7))
  name               String
  email              String
  password           String
  profileImageUrl    String?
  role               UserRoles  @default(FREELANCER)
  status             UserStatus @default(ACTIVE)
  emailVerified      Boolean    @default(false)
  needPasswordChange Boolean    @default(false)
  isDeleted          Boolean    @default(false)
  isBlocked          Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  freelancer            Freelancer?
  client                Client?
  postedJobs            Job[]       @relation("clientJobs")
  proposals             Proposal[]  @relation("userProposals")
  contractsAsClient     Contract[]  @relation("clientContracts")
  contractsAsFreelancer Contract[]  @relation("freelancerContracts")
  paymentsSent          Payment[]   @relation("clientPayments")
  paymentsReceived      Payment[]   @relation("freelancerPayments")

  @@unique([email])
  @@index([email])
  @@index([createdAt])
  @@map("users")
}
